# Number of valence bands
number_val_bands  2

# Number of conduction bands
number_cond_bands 2

# Temperature (in Kelvin)
temperature 0.00

# Initial order-parameter setup:
#   0 : random initialization
#   n : use the n-th exciton envelope function
initial_gapmat 1

# If initial_gapmat ≥ 1, read eigenvectors from “eigenvectors.h5”
read_eigenvectors

# Convergence threshold for the order parameter (in Rydbergs)
convergence_threshold 1.0D-12

# Minimum number of SCF iterations (even if converged earlier)
min_number_iterations 500

# Maximum number of SCF iterations
max_number_iterations 10000

# Save results every N iterations
save_number_iterations 500

# Number of consecutive iterations meeting the convergence threshold before stopping
converge_number_iterations 1000

# Restart calculation from an existing “delmat.h5” file
#restart

# HDF5 I/O mode: “Collective” or “Independent”
#HDF5_Collective
HDF5_Independent
